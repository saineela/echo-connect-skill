{
  "schema_version": 1,
  "kind": "nix-skill",
  "id": "ring-light",
  "name": "Ring Light",
  "version": "1.0.0",
  "description": "Control an Echo Dot 2 LED ring with solid RGB colors, built-in animations, named palettes, and brightness.",
  "category": "Smart Home",
  "publisher": "NIX Community Skills",
  "license": "MIT",
  "icon": "◉",
  "tags": ["echo-dot", "led", "rgb", "animations", "hardware"],
  "permissions": [
    "Connect to the configured Echo Dot ESPHome API over the local network.",
    "Control the Dot LED ring and its 12 segments when explicitly requested.",
    "Run the installed worker subprocess with the NIX user's OS permissions; this is not sandboxed."
  ],
  "setup_fields": [
    {
      "id": "device_ip",
      "label": "Echo Dot IP address",
      "type": "ipv4",
      "required": true,
      "help": "Private LAN IPv4 address of the Dot. Reserve this address in DHCP for stability."
    },
    {
      "id": "api_key",
      "label": "ESPHome API encryption key (PSK)",
      "type": "secret",
      "required": true,
      "help": "Base64-encoded 32-byte Noise key from the Dot's ESPHome configuration. Use a rotated key; do not reuse one posted publicly."
    }
  ],
  "runtime": {
    "protocol": "nix-skill-jsonl-v1",
    "entrypoint": "ring_light_worker.py",
    "requirements": "requirements.txt",
    "autostart": false
  },
  "tools": [
    {
      "name": "control_ring",
      "description": "Read the ring state or perform one requested action: turn on/off, set a solid RGB color, set brightness, run a prebuilt effect or stop it, or paint/animate a named palette.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {"type": "string", "enum": ["catalog", "state", "on", "off", "color", "brightness", "effect", "palette"]},
          "color": {"type": "string", "maxLength": 32},
          "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
          "brightness": {"type": "number", "minimum": 0.05, "maximum": 1.0},
          "effect": {"type": "string", "maxLength": 64},
          "palette": {"type": "string", "maxLength": 32},
          "mode": {"type": "string", "enum": ["paint", "animate"]}
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "action": {"type": "string", "maxLength": 32},
          "state": {
            "type": "object",
            "properties": {
              "on": {"type": "boolean"},
              "brightness": {"type": "number", "minimum": 0.0, "maximum": 1.0},
              "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
              "effect": {"type": "string", "maxLength": 64}
            },
            "additionalProperties": false
          },
          "device_connected": {"type": "boolean"},
          "available_effects": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 64}},
          "available_palettes": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 32}},
          "color_name": {"type": "string", "maxLength": 32},
          "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
          "brightness": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "effect": {"type": "string", "maxLength": 64},
          "palette": {"type": "string", "maxLength": 32},
          "mode": {"type": "string", "maxLength": 16},
          "message": {"type": "string", "maxLength": 240}
        },
        "required": ["ok", "action", "device_connected", "available_effects", "available_palettes", "message"],
        "additionalProperties": false
      }
    }
  ],
  "triggers": ["ring", "led ring", "ring light", "echo dot ring"],
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "ring_light_worker.py",
    "requirements.txt"
  ]
}
