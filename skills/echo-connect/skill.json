{
  "schema_version": 1,
  "kind": "nix-skill",
  "id": "echo-connect",
  "name": "Echo Connect",
  "version": "1.5.2",
  "description": "Echo Connect: control an Echo Dot 2 LED ring and speaker (volume, mute, speech, effects, RGB) via its native ESPHome API, with optional Unreal Speech cloud voices.",
  "assistant_summary": "You are Echo Connect, controlling the configured Echo Dot LED ring and speaker. For color requests, choose one RGB triplet that fits the user's description; do not use or invent a named-color preset table. For animations/effects, use only exact names in the live_device.available_effects catalog supplied for this request. Ring actions: catalog, color_catalog, state, on/off, color (rgb), brightness, effect. Speaker actions: volume (0.0-1.0), mute, unmute, say (text), play_url (an http(s) audio url, optional title), pause, resume, stop_speaking. Speech uses the operator's provider: an Unreal Speech cloud voice when API keys are stored, otherwise the built-in Piper voice (amy, lessac, hfc_female, kathleen, jenny, alba) as fallback; the Voice Lab may also pass voice, speed, expressiveness, variability. The result tts object reports which engine spoke, which key was used, and each key's monthly character/audio usage; quote its fallback reason when the local voice spoke instead of the cloud. Use 0.1 volume steps on the first adjustment and only announce what the device-reported state confirms.",
  "category": "Smart Home",
  "publisher": "NIX Community Skills",
  "license": "MIT",
  "icon": "◉",
  "tags": [
    "echo-dot",
    "led",
    "rgb",
    "animations",
    "hardware",
    "echo-connect"
  ],
  "permissions": [
    "Connect to the configured Echo Dot ESPHome API over the local network.",
    "Control the Dot LED ring, speaker volume/mute, and 12 segments when explicitly requested.",
    "Announce speech on the Dot when the user asks for it.",
    "Send requested announcement text to the Unreal Speech API over HTTPS when an API key is configured; the built-in local voice is used otherwise.",
    "Run the installed worker subprocess with the NIX user's OS permissions; this is not sandboxed."
  ],
  "setup_fields": [
    {
      "id": "device_ip",
      "label": "Echo Dot IP address",
      "type": "ipv4",
      "required": true,
      "help": "Private LAN IPv4 address of the Dot. Reserve this address in DHCP for stability."
    },
    {
      "id": "api_key",
      "label": "ESPHome API encryption key (PSK)",
      "type": "secret",
      "required": true,
      "help": "Base64-encoded 32-byte Noise key from the Dot's ESPHome configuration. Use a rotated key; do not reuse one posted publicly."
    },
    {
      "id": "tts_provider",
      "label": "Speech provider",
      "type": "string",
      "required": false,
      "help": "auto (default) uses Unreal Speech when a key is saved and the local voice otherwise; unrealspeech prefers the cloud; local always uses the built-in voice."
    },
    {
      "id": "unrealspeech_api_key",
      "label": "Unreal Speech API key 1",
      "type": "token",
      "required": false,
      "help": "Optional key from unrealspeech.com. Stored masked and never shown again. Used until 90% of its monthly limit, then key 2 takes over."
    },
    {
      "id": "unrealspeech_api_key_2",
      "label": "Unreal Speech API key 2",
      "type": "token",
      "required": false,
      "help": "Optional fallback key, used when key 1 is spent or fails."
    },
    {
      "id": "unrealspeech_api_key_3",
      "label": "Unreal Speech API key 3",
      "type": "token",
      "required": false,
      "help": "Optional final fallback key, used when keys 1 and 2 are spent or fail."
    },
    {
      "id": "unrealspeech_voice",
      "label": "Unreal Speech voice",
      "type": "string",
      "required": false,
      "help": "Cloud voice: amy (default), scarlett, dan, liv, or will. Ignored when the built-in local voice speaks."
    },
    {
      "id": "unrealspeech_monthly_characters",
      "label": "Monthly characters per key",
      "type": "string",
      "required": false,
      "help": "Default 250000 (Unreal Speech free tier). A key hands over to the next key at 90% of this."
    },
    {
      "id": "unrealspeech_monthly_audio_hours",
      "label": "Monthly audio hours per key",
      "type": "string",
      "required": false,
      "help": "Default 6 hours of generated audio (free tier). A key hands over to the next key at 90% of this."
    }
  ],
  "runtime": {
    "protocol": "nix-skill-jsonl-v1",
    "entrypoint": "ring_light_worker.py",
    "requirements": "requirements.txt",
    "autostart": false
  },
